{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "every-deck-of-cards",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "everydeckof.cards",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
