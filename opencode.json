{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "instructions": ["CONTRIBUTING.md"],
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "coverage/**", "test-results/**"]
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git switch*": "allow",
      "git checkout*": "allow",
      "git branch*": "allow",
      "git remote -v": "allow",
      "git stash list": "allow",
      "node *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "pnpm.cmd *": "allow",
      "Get-*": "allow",
      "Test-Path*": "allow",
      "Test-Connection*": "allow",
      "Resolve-Path*": "allow",
      "Select-String*": "allow",
      "Measure-Command*": "allow",
      "Compare-Object*": "allow",
      "where.exe*": "allow",
      "whereis*": "allow",
      "echo *": "allow",
      "Write-Output*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "Remove-Item*": "ask",
      "del *": "ask",
      "wrangler deploy*": "ask",
      "npx *wrangler deploy*": "ask",
      "pnpm *wrangler deploy*": "ask",
      "pnpm.cmd *wrangler deploy*": "ask",
      "pnpm deploy*": "ask",
      "pnpm.cmd deploy*": "ask",
      "pnpm run deploy*": "ask",
      "pnpm.cmd run deploy*": "ask"
    }
  }
}
