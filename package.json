{
  "name": "every-deck-of-cards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "vp test bench --run",
    "build": "tsc --noEmit && vp build",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "vp dev",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "preview": "vp preview",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0",
    "@solidjs/web": "2.0.3",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "26.6.7",
    "eslint": "10.15.0",
    "eslint-plugin-solid": "0.20.1",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.168.0"
  }
}
