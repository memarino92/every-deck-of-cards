{
  "name": "every-deck-of-cards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "vp test bench --run",
    "build": "tsc --noEmit && vp build",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "vp dev",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "preview": "vp preview",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.19",
    "@solidjs/web": "2.0.0-rc.4",
    "solid-js": "2.0.0-rc.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@solidjs/vite-plugin": "3.0.0-next.35",
    "@types/node": "26.3.0",
    "eslint": "10.9.1",
    "eslint-plugin-solid": "0.16.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "wrangler": "4.127.0",
    "vite-plus": "catalog:"
  }
}
